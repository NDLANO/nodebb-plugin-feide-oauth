{
  "name": "nodebb-plugin-feide-oauth",
  "version": "0.0.14",
  "description": "NodeBB Feide OAuth SSO",
  "main": "library.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/NDLANO/nodebb-plugin-feide-oauth"
  },
  "keywords": [
    "nodebb",
    "plugin",
    "oauth",
    "oauth2",
    "sso",
    "single sign on",
    "login",
    "registration",
    "Feide"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/NDLANO/nodebb-plugin-feide-oauth/issues"
  },
  "readme": "",
  "readmeFilename": "README.md",
  "dependencies": {
    "@node-saml/passport-saml": "^5.0.0",
    "async": "^3.2.0",
    "passport-oauth": "~1.0.0",
    "passport-openidconnect": "^0.1.2"
  },
  "nbbpm": {
    "compatibility": "^4.0.0"
  },
  "scripts": {
    "lint": "yarn format-check && yarn lint-es",
    "lint-es": "eslint --cache --cache-location '.eslintcache/' --max-warnings=0 library.js",
    "format": "prettier '**/*(*.js|*.jsx|*.ts|*.tsx|*.graphql)' --write",
    "format-check": "prettier '**/*(*.js|*.jsx|*.ts|*.tsx|*.graphql)' --check",
    "check-all": "yarn format-check && yarn lint-es"
  },
  "devDependencies": {
    "@babel/core": "^7.23.2",
    "@babel/preset-env": "^7.23.2",
    "@babel/preset-react": "^7.22.15",
    "@babel/preset-typescript": "^7.23.2",
    "@commitlint/config-angular": "15.0.0",
    "@types/passport-openidconnect": "^0.1.3",
    "eslint": "^9.0.0",
    "eslint-config-ndla": "^3.3.0",
    "eslint-plugin-import": "^2.27.5",
    "husky": "9.1.6",
    "lint-staged": "15.2.10",
    "prettier": "^3.1.0",
    "typescript": "^5.3.2"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged",
      "commit-msg": "commitlint -E HUSKY_GIT_PARAMS"
    }
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "git add"
    ]
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
