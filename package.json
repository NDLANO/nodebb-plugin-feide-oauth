{
  "name": "nodebb-plugin-feide-oauth",
  "version": "0.0.1",
  "description": "NodeBB Feide OAuth SSO",
  "main": "library.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/NDLANO/nodebb-plugin-feide-oauth"
  },
  "keywords": [
    "nodebb",
    "plugin",
    "oauth",
    "oauth2",
    "sso",
    "single sign on",
    "login",
    "registration"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/NDLANO/nodebb-plugin-feide-oauth/issues"
  },
  "readme": "",
  "readmeFilename": "README.md",
  "dependencies": {
    "async": "^3.2.0",
    "passport-oauth": "~1.0.0"
  },
  "nbbpm": {
    "compatibility": "^1.0.1",
    "index": false
  },
  "scripts": {
    "lint": "yarn format-check && yarn lint-es",
    "lint-es": "eslint --cache --cache-location '.eslintcache/' --ext .js,.jsx,.ts,.tsx --max-warnings=0 static library.js",
    "format": "prettier '**/*(*.js|*.jsx|*.ts|*.tsx|*.graphql)' --write",
    "format-check": "prettier '**/*(*.js|*.jsx|*.ts|*.tsx|*.graphql)' --check",
    "check-all": "yarn format-check && yarn lint-es"
  },
  "devDependencies": {
    "@commitlint/config-angular": "15.0.0",
    "eslint": "^9.0.0",
    "eslint-config-airbnb-base": "15.0.0",
    "eslint-config-nodebb": "^0.2.1",
    "eslint-plugin-import": "^2.27.5",
    "husky": "9.1.6",
    "lint-staged": "15.2.10",
    "prettier": "^3.1.0",
    "typescript": "^5.3.2"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged",
      "commit-msg": "commitlint -E HUSKY_GIT_PARAMS"
    }
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "git add"
    ]
  }
}
